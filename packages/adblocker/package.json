      "name": "Anton Lazarev",
      "email": "antonok35@gmail.com"
    }
  ],
  "devDependencies": {
    "@types/node": "26.2.0",
    "tshy": "^4.1.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ghostery/adblocker-content": "^2.18.2",
    "@ghostery/adblocker-extended-selectors": "^2.18.2",
    "@ghostery/url-parser": "^1.3.1",
    "@remusao/guess-url-type": "^2.1.0",
    "@remusao/small": "^2.1.0",
    "@remusao/smaz": "^2.2.0",
    "tldts-experimental": "^7.4.10"
  }
}
